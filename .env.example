# Local development (SQLite)
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=file:./payload.db

# Go High Level — budget planner
#
# Submit mode:
#   embed (default) — GHL form loads in an iframe on the same page
#   redirect        — send visitor to the hosted GHL form page
# NEXT_PUBLIC_BUDGET_PLANNER_SUBMIT_MODE=embed
#
# GHL form embed URL (from Forms → Integrate → Embed). No query params.
# Hidden field Unique Keys must match lib/budget-planner-ghl.ts.
# NEXT_PUBLIC_GHL_BUDGET_PLANNER_FORM_URL=https://api.leadconnectorhq.com/widget/form/xxxxxxxx

# Go High Level — chiropractic offer builder
#
# Submit mode:
#   embed (default) — GHL form loads in an iframe on the same page
#   redirect        — send visitor to the hosted GHL form page
# NEXT_PUBLIC_OFFER_BUILDER_SUBMIT_MODE=embed
#
# GHL form embed URL (from Forms → Integrate → Embed). No query params.
# Hidden field Unique Keys must match lib/offer-builder-ghl.ts.
# NEXT_PUBLIC_GHL_OFFER_BUILDER_FORM_URL=https://api.leadconnectorhq.com/widget/form/vasaIIoLDHyl4AsqbhgX

# Local admin reset (optional): npm run reset:local-admin
# LOCAL_ADMIN_EMAIL=matt@madebylakeside.com
# LOCAL_ADMIN_PASSWORD=LakesideLocal1!

# Production on Vercel (set in Vercel dashboard — do not commit real values)
# Required for Production AND Preview deployments (PR builds use Preview env).
# PAYLOAD_SECRET=<generate with: openssl rand -hex 32>  (required for /admin)
# POSTGRES_URL=<auto-set when you link Neon Postgres>
# POSTGRES_URL_NON_POOLING=<auto-set when you link Neon Postgres>
# BLOB_STORE_ID=<auto-set when you connect Vercel Blob via OIDC — used for uploads>
# BLOB_READ_WRITE_TOKEN=<optional — copy from Blob store Quickstart → ".env.local" tab for client uploads>

# To regenerate Postgres migrations locally (uses postgres adapter when POSTGRES_URL is set):
# POSTGRES_URL=<copy from Vercel> pnpm run migrate:create:vercel
