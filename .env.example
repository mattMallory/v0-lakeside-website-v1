# Local development (SQLite)
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=file:./payload.db

# Go High Level — budget planner & offer builder
#
# Both tools use native HTML email forms that POST to /api/ghl/contact when
# GHL_PRIVATE_INTEGRATION_TOKEN and GHL_LOCATION_ID are set (see below).
# Custom field Unique Keys must match lib/budget-planner-ghl.ts and lib/offer-builder-ghl.ts.
# Map each key to its GHL field ID (optional — IDs are auto-fetched from GHL when omitted):
# GHL_CF_<UNIQUE_KEY_UPPERCASE>=<field_id>
#
# Legacy iframe embed URLs are no longer used by the site:
# NEXT_PUBLIC_GHL_BUDGET_PLANNER_FORM_URL
# NEXT_PUBLIC_GHL_OFFER_BUILDER_FORM_URL
# NEXT_PUBLIC_BUDGET_PLANNER_SUBMIT_MODE
# NEXT_PUBLIC_OFFER_BUILDER_SUBMIT_MODE

# Go High Level — Private Integration (native HTML forms → server API → GHL)
# Server-only — never expose these in the browser or NEXT_PUBLIC_* vars.
# Create in GHL → Settings → Private Integrations → scopes: contacts.write
# GHL_PRIVATE_INTEGRATION_TOKEN=pit-...
# GHL_LOCATION_ID=your-sub-account-location-id
#
# Consultation page (/consultation): uses the native HTML form automatically when the
# server vars above are set. Force legacy iframe embed with:
# NEXT_PUBLIC_GHL_CONTACT_FORM_MODE=embed
#
# Optional custom field overrides (Unique Key → env var). Auto-resolved from GHL when omitted.
# Budget planner keys: patient_value, market, service_type, followup, lead_conversion,
# budget_low, budget_high, budget_range, cost_per_lead, cost_per_patient, next_step,
# planner_source, planner_page_url
# Consultation "What would you like help with?" custom field (Unique Key: what_would_you_like_help_with)
# Optional field ID override if auto-mapping fails:
# GHL_CF_WHAT_WOULD_YOU_LIKE_HELP_WITH=<field id from GHL Custom Fields>
# GHL_CONSULTATION_MESSAGE_FIELD_ID=<same field id>

# Local admin reset (optional): npm run reset:local-admin
# LOCAL_ADMIN_EMAIL=matt@madebylakeside.com
# LOCAL_ADMIN_PASSWORD=LakesideLocal1!

# Production on Vercel (set in Vercel dashboard — do not commit real values)
# Required for Production AND Preview deployments (PR builds use Preview env).
# PAYLOAD_SECRET=<generate with: openssl rand -hex 32>  (required for /admin)
# POSTGRES_URL=<auto-set when you link Neon Postgres>
# POSTGRES_URL_NON_POOLING=<auto-set when you link Neon Postgres>
# BLOB_STORE_ID=<auto-set when you connect Vercel Blob via OIDC — used for uploads>
# BLOB_READ_WRITE_TOKEN=<optional — copy from Blob store Quickstart → ".env.local" tab for client uploads>

# To regenerate Postgres migrations locally (uses postgres adapter when POSTGRES_URL is set):
# POSTGRES_URL=<copy from Vercel> pnpm run migrate:create:vercel
